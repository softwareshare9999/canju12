<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="480dp"
    android:background="@drawable/dialog_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="60dp" android:layout_height="60dp"
                android:src="@mipmap/logo"
                android:layout_marginStart="24dp"/>

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/first_run_title"
                android:textSize="20sp" android:textColor="#000000"
                android:textStyle="bold"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="2dp"
            android:background="#000000" android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginBottom="8dp">

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textStyle="bold" android:textSize="16sp"
                android:textColor="#FF0000" android:text="@string/section_goal"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/goal_text"
                android:textSize="14sp" android:textColor="#888888"
                android:layout_marginBottom="10dp" android:layout_marginTop="2dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textStyle="bold" android:textSize="16sp"
                android:textColor="#FF0000" android:text="@string/section_moves"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/moves_text"
                android:textSize="14sp" android:textColor="#888888"
                android:layout_marginBottom="10dp" android:layout_marginTop="2dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textStyle="bold" android:textSize="16sp"
                android:textColor="#FF0000" android:text="@string/section_import_tiku"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/import_tiku_text"
                android:textSize="14sp" android:textColor="#888888"
                android:layout_marginBottom="10dp" android:layout_marginTop="2dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textStyle="bold" android:textSize="16sp"
                android:textColor="#FF0000" android:text="@string/section_import_style"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/import_style_text"
                android:textSize="14sp" android:textColor="#888888"
                android:layout_marginBottom="10dp" android:layout_marginTop="2dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textStyle="bold" android:textSize="16sp"
                android:textColor="#FF0000" android:text="@string/section_other"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/other_text"
                android:textSize="14sp" android:textColor="#888888"
                android:layout_marginTop="2dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textStyle="bold" android:textSize="16sp"
                android:textColor="#FF0000" android:text="@string/section_open_source"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/open_source_text"
                android:textSize="14sp" android:textColor="#888888"
                android:layout_marginBottom="10dp" android:layout_marginTop="2dp"/>



        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#E0E0E0" android:layout_marginBottom="8dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/cheer_long"
            android:textSize="16sp" android:textColor="#00008B"
            android:gravity="center" android:layout_marginBottom="8dp"/>

    </LinearLayout>
</ScrollView>

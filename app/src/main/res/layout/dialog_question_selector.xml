<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:id="@+id/tvTikuTitle"
            android:text="@string/tiku_name"
            android:textSize="18sp"
            android:textColor="#333333"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvQuestionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/total_zero_questions"
            android:textSize="14sp"
            android:textColor="#666666"/>

    </LinearLayout>

    <!-- 图例 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_question_item_done"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/legend_done"
            android:textSize="12sp"
            android:textColor="#666666"/>

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_question_item_current"
            android:layout_marginStart="8dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/legend_current"
            android:textSize="12sp"
            android:textColor="#666666"/>

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_question_item_normal"
            android:layout_marginStart="8dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/legend_todo"
            android:textSize="12sp"
            android:textColor="#666666"/>

    </LinearLayout>

    <!-- 网格布局 -->
    <GridView
        android:id="@+id/gridViewQuestions"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:numColumns="10"
        android:verticalSpacing="0dp"
        android:horizontalSpacing="0dp"
        android:stretchMode="columnWidth"
        android:gravity="center"
        android:background="#F5F5F5"
        android:listSelector="@android:color/transparent"
        android:padding="0dp"/>

</LinearLayout>
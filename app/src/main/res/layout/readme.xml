<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="500dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/readme_intro"
            android:textSize="16sp" android:textStyle="bold" android:textColor="#333333"
            android:lineSpacingExtra="3dp" android:layout_marginBottom="12dp"/>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/readme_section_goal" android:textSize="16sp" android:textColor="#FF0000"
            android:textStyle="bold" android:layout_marginTop="12dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/goal_text"
            android:textSize="14sp" android:textColor="#555555" android:lineSpacingExtra="2dp" android:layout_marginTop="4dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/readme_section_custom_tiku" android:textSize="16sp" android:textColor="#FF0000"
            android:textStyle="bold" android:layout_marginTop="12dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/readme_custom_tiku"
            android:textSize="14sp" android:textColor="#555555" android:lineSpacingExtra="2dp" android:layout_marginTop="4dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/readme_section_custom_style" android:textSize="16sp" android:textColor="#FF0000"
            android:textStyle="bold" android:layout_marginTop="12dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/readme_custom_style"
            android:textSize="14sp" android:textColor="#555555" android:lineSpacingExtra="2dp" android:layout_marginTop="4dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/readme_section_other" android:textSize="16sp" android:textColor="#FF0000"
            android:textStyle="bold" android:layout_marginTop="12dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/readme_other"
            android:textSize="14sp" android:textColor="#555555" android:lineSpacingExtra="2dp" android:layout_marginTop="4dp"/>


        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/readme_section_thanks" android:textSize="16sp" android:textColor="#FF0000"
            android:textStyle="bold" android:layout_marginTop="12dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/readme_thanks"
            android:textSize="14sp" android:textColor="#555555" android:lineSpacingExtra="2dp" android:layout_marginTop="4dp"/>




        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/readme_section_words" android:textSize="16sp" android:textColor="#FF0000"
            android:textStyle="bold" android:layout_marginTop="12dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/readme_words"
            android:textSize="14sp" android:textColor="#555555" android:lineSpacingExtra="2dp" android:layout_marginTop="4dp"/>


        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/readme_section_license" android:textSize="16sp" android:textColor="#FF0000"
            android:textStyle="bold" android:layout_marginTop="12dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/readme_license"
            android:textSize="14sp" android:textColor="#555555" android:lineSpacingExtra="2dp" android:layout_marginTop="4dp"/>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginTop="12dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/readme_author" android:textSize="15sp" android:textColor="#0000FF"
            android:textStyle="bold" android:gravity="right" android:layout_marginTop="12dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/readme_date" android:textSize="15sp" android:textColor="#0000FF"
            android:textStyle="bold" android:gravity="right"/>

    </LinearLayout>
</ScrollView>